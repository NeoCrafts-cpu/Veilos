# Copy to .env locally. Never commit real seeds, mnemonics, or private endpoints.
# Hosted UI (Vercel / Render) bakes VITE_ values at build time. Do not put a
# wallet seed on the host. Proof server stays on loopback.

# undeployed | preview | preprod
VELIOS_NETWORK=preview
VITE_VELIOS_NETWORK=preview

# Official MidnightJS undeployed defaults (re-confirm after package install)
VELIOS_INDEXER_HTTP=http://localhost:8088/api/v4/graphql
VELIOS_INDEXER_WS=ws://localhost:8088/api/v4/graphql/ws
VELIOS_NODE=ws://localhost:9944
VELIOS_PROOF_SERVER=http://localhost:6300

# Preview (1AM / Lace): set both network vars to preview, compile contracts,
# serve ZK artifacts via `pnpm dev`, then connect the wallet and sign deploys.
# Proof server still required (Docker proof-server or the wallet Proof Station).
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# Official Node CLI deploy (`pnpm deploy:preview`). Hex seed from --fresh, or a
# 12/24-word mnemonic. Set only one. Never commit real values.
# VELIOS_WALLET_SEED=
# 1AM 24-word phrase for `pnpm dust:1am` (keep the hex seed too; pass --use-mnemonic).
# VELIOS_WALLET_MNEMONIC=
# VELIOS_PRIVATE_STORE_PASSWORD=
# Must include at least 3 of: uppercase, lowercase, digits, special characters.
# Hex-only values fail the official Level private-state store.
# VELIOS_ORG_NAME=ACME AUTONOMOUS SYSTEMS

# Public Preview contract is baked into `@velios/midnight` `PREVIEW_DEPLOYMENT`.
# Operator private state is gitignored `.private-state/preview.json`
# (written by `pnpm deploy:preview` or `pnpm --filter @velios/cli export-private-state`).
