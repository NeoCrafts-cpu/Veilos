// VELIOS Wave 2 economy contract.
// Compact 0.23 primitives verified by disposable spikes:
//   receiveUnshielded / sendUnshielded (unshielded-night.compact)
//   HistoricMerkleTree + merkleTreePathRoot (historic-merkle.compact)
//   UserAddress.bytes (user-address.compact)
// Wave 1 authorization.compact remains the legacy deployment.

pragma language_version 0.23;
import CompactStandardLibrary;

enum OrganizationStatus { inactive, active }
enum CredentialClass { admin, treasury, procurement, auditor, agent }
enum AuthResult { authorized }
enum ProposalStatus { open, finalized }
enum ProcurementStatus { open, awarded }

struct AuthReceipt {
  agentId: Bytes<32>;
  result: AuthResult;
  intentCommitment: Bytes<32>;
  periodStart: Uint<64>;
  periodEnd: Uint<64>;
}

struct SettlementPublic {
  actionId: Bytes<32>;
  amount: Uint<64>;
  recipient: Bytes<32>;
  periodStart: Uint<64>;
}

struct ProposalPublic {
  actionCommitment: Bytes<32>;
  voteStart: Uint<64>;
  voteEnd: Uint<64>;
  quorumCommitment: Bytes<32>;
  status: ProposalStatus;
  yesCount: Uint<64>;
  noCount: Uint<64>;
}

struct ProcurementPublic {
  windowStart: Uint<64>;
  windowEnd: Uint<64>;
  eligibility: Bytes<32>;
  status: ProcurementStatus;
  awardCommitment: Bytes<32>;
  winnerBidCommitment: Bytes<32>;
}

struct DisclosurePublic {
  auditorId: Bytes<32>;
  scopeCommitment: Bytes<32>;
  expires: Uint<64>;
}

export ledger organizationId: Bytes<32>;
export ledger organizationStatus: OrganizationStatus;
export ledger adminCommitment: Bytes<32>;
export ledger credentialTree: HistoricMerkleTree<10, Bytes<32>>;
export ledger revokedNullifiers: Set<Bytes<32>>;
export ledger credentialCount: Counter;
export ledger usedActionIds: Set<Bytes<32>>;
export ledger authorizations: Map<Bytes<32>, AuthReceipt>;
export ledger actionCount: Counter;
export ledger settlementNullifiers: Set<Bytes<32>>;
export ledger settlements: Map<Bytes<32>, SettlementPublic>;
export ledger settlementCount: Counter;
export ledger proposals: Map<Bytes<32>, ProposalPublic>;
export ledger voteNullifiers: Set<Bytes<32>>;
export ledger ballotCommitments: Map<Bytes<32>, Bytes<32>>;
export ledger procurements: Map<Bytes<32>, ProcurementPublic>;
export ledger bidCommitments: Map<Bytes<32>, Bytes<32>>;
export ledger disclosures: Map<Bytes<32>, DisclosurePublic>;
export ledger spendCommitment: Bytes<32>;

witness ownerSecret(): Bytes<32>;
witness holderSecret(): Bytes<32>;
witness credentialClass(): Uint<64>;
witness credentialExpiry(): Uint<64>;
witness credentialSalt(): Bytes<32>;
witness credentialPath(): MerkleTreePath<10, Bytes<32>>;
witness revocationSecret(): Bytes<32>;
witness intentSalt(): Bytes<32>;
witness reasonDigestW(): Bytes<32>;
witness vendorId(): Bytes<32>;
witness perActionLimit(): Uint<64>;
witness dailyLimit(): Uint<64>;
witness spendPeriodStart(): Uint<64>;
witness spendDaily(): Uint<64>;
witness spendSalt(): Bytes<32>;
witness nextSpendSalt(): Bytes<32>;
witness policySalt(): Bytes<32>;
witness ballotChoice(): Uint<64>;
witness ballotSalt(): Bytes<32>;
witness tallyYes(): Uint<64>;
witness tallyNo(): Uint<64>;
witness bidSalt(): Bytes<32>;
witness bidAmount(): Uint<64>;
witness awardSalt(): Bytes<32>;
witness winnerHolder(): Bytes<32>;

circuit encodeUint64(n: Uint<64>): Bytes<32> {
  return n as Field as Bytes<32>;
}

export circuit ownerCommitmentOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "velios:owner:"),
    sk
  ]);
}

export circuit holderCommitmentOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "velios:holder:"),
    sk
  ]);
}

export circuit credentialCommitmentOf(
  holder: Bytes<32>,
  org: Bytes<32>,
  classId: Uint<64>,
  expiry: Uint<64>,
  salt: Bytes<32>,
  vendor: Bytes<32>,
  perAction: Uint<64>,
  daily: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<9, Bytes<32>>>([
    pad(32, "velios:cred:"),
    holder,
    org,
    encodeUint64(classId),
    encodeUint64(expiry),
    salt,
    vendor,
    encodeUint64(perAction),
    encodeUint64(daily)
  ]);
}

export circuit revocationNullifierOf(commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "velios:credrev:"),
    commitment
  ]);
}

export circuit spendCommitmentOf(
  periodStart: Uint<64>,
  dailySpend: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "velios:spend:"),
    encodeUint64(periodStart),
    encodeUint64(dailySpend),
    salt
  ]);
}

export circuit bidKeyOf(procurementId: Bytes<32>, holder: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "velios:bidkey:"),
    procurementId,
    holder
  ]);
}

export circuit intentCommitmentOf(
  actionId: Bytes<32>,
  agentId: Bytes<32>,
  org: Bytes<32>,
  actionType: Uint<64>,
  amount: Uint<64>,
  vendor: Bytes<32>,
  reason: Bytes<32>,
  periodStart: Uint<64>,
  periodEnd: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<11, Bytes<32>>>([
    pad(32, "velios:intent:"),
    actionId,
    agentId,
    org,
    encodeUint64(actionType),
    encodeUint64(amount),
    vendor,
    reason,
    encodeUint64(periodStart),
    encodeUint64(periodEnd),
    salt
  ]);
}

export circuit settlementNullifierOf(actionId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "velios:settle:"),
    actionId
  ]);
}

export circuit ballotCommitmentOf(
  proposalId: Bytes<32>,
  holder: Bytes<32>,
  choice: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "velios:ballot:"),
    proposalId,
    holder,
    encodeUint64(choice),
    salt
  ]);
}

export circuit voteNullifierOf(proposalId: Bytes<32>, holder: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "velios:votenul:"),
    proposalId,
    holder
  ]);
}

export circuit bidCommitmentOf(
  procurementId: Bytes<32>,
  holder: Bytes<32>,
  amount: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "velios:bid:"),
    procurementId,
    holder,
    encodeUint64(amount),
    salt
  ]);
}

export circuit awardCommitmentOf(
  procurementId: Bytes<32>,
  winnerBid: Bytes<32>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "velios:award:"),
    procurementId,
    winnerBid,
    salt
  ]);
}

export circuit addressCommitmentOf(addr: UserAddress): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "velios:addr:"),
    addr.bytes
  ]);
}

circuit assertWindowIsNow(periodStart: Uint<64>, periodEnd: Uint<64>): [] {
  assert(periodEnd > periodStart, "invalid period");
  assert((periodEnd - periodStart) as Uint<64> <= 86400, "period too long");
  assert(kernel.blockTimeGreaterThan(periodStart), "period not started");
  assert(!kernel.blockTimeGreaterThan(periodEnd), "period elapsed");
}

circuit assertAdmin(): [] {
  assert(adminCommitment == ownerCommitmentOf(ownerSecret()), "unauthorized");
}

circuit currentCredentialCommitment(): Bytes<32> {
  return credentialCommitmentOf(
    holderCommitmentOf(holderSecret()),
    organizationId,
    credentialClass(),
    credentialExpiry(),
    credentialSalt(),
    vendorId(),
    perActionLimit(),
    dailyLimit()
  );
}

circuit assertCredential(classId: Uint<64>, periodEnd: Uint<64>): [] {
  const commitment = currentCredentialCommitment();
  const path = credentialPath();
  assert(path.leaf == commitment, "credential path");
  assert(credentialTree.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "credential path");
  assert(credentialClass() == classId, "credential class");
  assert(credentialExpiry() >= periodEnd, "credential expired");
  const nullifier = revocationNullifierOf(commitment);
  assert(!revokedNullifiers.member(disclose(nullifier)), "credential revoked");
}

circuit assertSpendBinding(publicPeriodStart: Uint<64>): [] {
  const empty = default<Bytes<32>>;
  const current = spendCommitmentOf(spendPeriodStart(), spendDaily(), spendSalt());
  assert(spendCommitment == empty || spendCommitment == current, "spend predicate failed");
  const committedStart = disclose(spendPeriodStart());
  assert(!(spendCommitment == empty) || committedStart == 0, "spend predicate failed");
  assert(!(spendCommitment == empty) || spendDaily() == 0, "spend predicate failed");
  assert(committedStart <= publicPeriodStart, "stale period");
  assert(
    committedStart == publicPeriodStart ||
    committedStart == 0 ||
    kernel.blockTimeGreaterThan((committedStart + 86400) as Uint<64>),
    "period not elapsed"
  );
}

constructor(orgId: Bytes<32>) {
  organizationId = disclose(orgId);
  organizationStatus = OrganizationStatus.active;
  adminCommitment = disclose(ownerCommitmentOf(ownerSecret()));
}

export circuit issueCredential(commitment: Bytes<32>): [] {
  assertAdmin();
  assert(organizationStatus == OrganizationStatus.active, "organization inactive");
  credentialTree.insert(disclose(commitment));
  credentialCount.increment(1);
}

export circuit revokeCredential(nullifier: Bytes<32>): [] {
  assertAdmin();
  const publicNullifier = disclose(nullifier);
  assert(!revokedNullifiers.member(publicNullifier), "already revoked");
  revokedNullifiers.insert(publicNullifier);
}

export circuit authorizePayment(
  agentId: Bytes<32>,
  actionId: Bytes<32>,
  amount: Uint<64>,
  vendor: Bytes<32>,
  periodStart: Uint<64>,
  periodEnd: Uint<64>
): [] {
  const publicAgentId = disclose(agentId);
  const publicActionId = disclose(actionId);
  const publicPeriodStart = disclose(periodStart);
  const publicPeriodEnd = disclose(periodEnd);
  assert(organizationStatus == OrganizationStatus.active, "organization inactive");
  assertWindowIsNow(publicPeriodStart, publicPeriodEnd);
  assertCredential(1, publicPeriodEnd);
  assert(vendor == vendorId(), "policy predicate failed");
  assert(amount <= perActionLimit(), "policy predicate failed");
  assertSpendBinding(publicPeriodStart);
  const carried = spendPeriodStart() == publicPeriodStart ? spendDaily() : 0;
  const nextSpend = carried + amount;
  assert(nextSpend >= carried, "policy predicate failed");
  assert(nextSpend <= dailyLimit(), "policy predicate failed");
  const nextSpend64 = nextSpend as Uint<64>;
  assert(!usedActionIds.member(publicActionId), "replay");
  usedActionIds.insert(publicActionId);
  const intentC = intentCommitmentOf(
    publicActionId,
    publicAgentId,
    organizationId,
    0,
    amount,
    vendor,
    reasonDigestW(),
    publicPeriodStart,
    publicPeriodEnd,
    intentSalt()
  );
  authorizations.insert(publicActionId, AuthReceipt {
    agentId: publicAgentId,
    result: AuthResult.authorized,
    intentCommitment: disclose(intentC),
    periodStart: publicPeriodStart,
    periodEnd: publicPeriodEnd
  });
  actionCount.increment(1);
  spendCommitment = disclose(spendCommitmentOf(publicPeriodStart, nextSpend64, nextSpendSalt()));
}

export circuit depositNight(amount: Uint<128>): [] {
  assertAdmin();
  receiveUnshielded(default<Bytes<32>>, disclose(amount));
}

export circuit settleAuthorizedPayment(
  actionId: Bytes<32>,
  amount: Uint<64>,
  recipient: UserAddress
): [] {
  const publicActionId = disclose(actionId);
  assert(authorizations.member(publicActionId), "authorization missing");
  const receipt = authorizations.lookup(publicActionId);
  assert(receipt.result == AuthResult.authorized, "not authorized");
  const addrC = addressCommitmentOf(recipient);
  assert(addrC == vendorId(), "recipient mismatch");
  const intentC = intentCommitmentOf(
    publicActionId,
    receipt.agentId,
    organizationId,
    0,
    amount,
    vendorId(),
    reasonDigestW(),
    receipt.periodStart,
    receipt.periodEnd,
    intentSalt()
  );
  assert(receipt.intentCommitment == intentC, "intent mismatch");
  const settleN = disclose(settlementNullifierOf(publicActionId));
  assert(!settlementNullifiers.member(settleN), "already settled");
  settlementNullifiers.insert(settleN);
  settlements.insert(publicActionId, SettlementPublic {
    actionId: publicActionId,
    amount: disclose(amount),
    recipient: disclose(addrC),
    periodStart: receipt.periodStart
  });
  settlementCount.increment(1);
  sendUnshielded(
    default<Bytes<32>>,
    disclose(amount) as Uint<128>,
    right<ContractAddress, UserAddress>(disclose(recipient))
  );
}

export circuit createProposal(
  proposalId: Bytes<32>,
  actionCommitment: Bytes<32>,
  voteStart: Uint<64>,
  voteEnd: Uint<64>,
  quorumCommitment: Bytes<32>
): [] {
  assertAdmin();
  const publicId = disclose(proposalId);
  assert(!proposals.member(publicId), "proposal exists");
  proposals.insert(publicId, ProposalPublic {
    actionCommitment: disclose(actionCommitment),
    voteStart: disclose(voteStart),
    voteEnd: disclose(voteEnd),
    quorumCommitment: disclose(quorumCommitment),
    status: ProposalStatus.open,
    yesCount: 0,
    noCount: 0
  });
}

export circuit castBallot(proposalId: Bytes<32>): [] {
  const publicId = disclose(proposalId);
  assert(proposals.member(publicId), "proposal missing");
  const proposal = proposals.lookup(publicId);
  assert(proposal.status == ProposalStatus.open, "proposal closed");
  assert(kernel.blockTimeGreaterThan(proposal.voteStart), "vote not started");
  assert(!kernel.blockTimeGreaterThan(proposal.voteEnd), "vote elapsed");
  assertCredential(0, proposal.voteEnd);
  const holder = holderCommitmentOf(holderSecret());
  const nullifier = voteNullifierOf(publicId, holder);
  assert(!voteNullifiers.member(disclose(nullifier)), "already voted");
  voteNullifiers.insert(disclose(nullifier));
  const ballotC = ballotCommitmentOf(publicId, holder, ballotChoice(), ballotSalt());
  ballotCommitments.insert(disclose(nullifier), disclose(ballotC));
}

export circuit finalizeProposal(proposalId: Bytes<32>): [] {
  assertAdmin();
  const publicId = disclose(proposalId);
  assert(proposals.member(publicId), "proposal missing");
  const proposal = proposals.lookup(publicId);
  assert(proposal.status == ProposalStatus.open, "proposal closed");
  assert(kernel.blockTimeGreaterThan(proposal.voteEnd), "vote still open");
  proposals.insert(publicId, ProposalPublic {
    actionCommitment: proposal.actionCommitment,
    voteStart: proposal.voteStart,
    voteEnd: proposal.voteEnd,
    quorumCommitment: proposal.quorumCommitment,
    status: ProposalStatus.finalized,
    yesCount: 0,
    noCount: 0
  });
}

export circuit createProcurement(
  procurementId: Bytes<32>,
  windowStart: Uint<64>,
  windowEnd: Uint<64>,
  eligibility: Bytes<32>
): [] {
  assertAdmin();
  const publicId = disclose(procurementId);
  assert(!procurements.member(publicId), "procurement exists");
  procurements.insert(publicId, ProcurementPublic {
    windowStart: disclose(windowStart),
    windowEnd: disclose(windowEnd),
    eligibility: disclose(eligibility),
    status: ProcurementStatus.open,
    awardCommitment: default<Bytes<32>>,
    winnerBidCommitment: default<Bytes<32>>
  });
}

export circuit submitBid(procurementId: Bytes<32>): [] {
  const publicId = disclose(procurementId);
  assert(procurements.member(publicId), "procurement missing");
  const lot = procurements.lookup(publicId);
  assert(lot.status == ProcurementStatus.open, "procurement closed");
  assert(kernel.blockTimeGreaterThan(lot.windowStart), "bidding not started");
  assert(!kernel.blockTimeGreaterThan(lot.windowEnd), "bidding elapsed");
  assertCredential(2, lot.windowEnd);
  const holder = holderCommitmentOf(holderSecret());
  const bidC = bidCommitmentOf(publicId, holder, bidAmount(), bidSalt());
  const bidKey = bidKeyOf(publicId, holder);
  assert(!bidCommitments.member(disclose(bidKey)), "duplicate bid");
  bidCommitments.insert(disclose(bidKey), disclose(bidC));
}

export circuit awardProcurement(procurementId: Bytes<32>, winnerBid: Bytes<32>, actionId: Bytes<32>): [] {
  assertAdmin();
  const publicId = disclose(procurementId);
  const publicActionId = disclose(actionId);
  const publicWinner = disclose(winnerBid);
  assert(procurements.member(publicId), "procurement missing");
  assert(authorizations.member(publicActionId), "authorization missing");
  assert(!settlementNullifiers.member(disclose(settlementNullifierOf(publicActionId))), "already settled");
  const lot = procurements.lookup(publicId);
  assert(lot.status == ProcurementStatus.open, "procurement closed");
  const publicHolder = disclose(winnerHolder());
  const winnerKey = bidKeyOf(publicId, publicHolder);
  assert(bidCommitments.member(winnerKey), "bid missing");
  assert(bidCommitments.lookup(winnerKey) == publicWinner, "winner mismatch");
  const awardC = awardCommitmentOf(publicId, publicWinner, awardSalt());
  procurements.insert(publicId, ProcurementPublic {
    windowStart: lot.windowStart,
    windowEnd: lot.windowEnd,
    eligibility: lot.eligibility,
    status: ProcurementStatus.awarded,
    awardCommitment: disclose(awardC),
    winnerBidCommitment: publicWinner
  });
}

export circuit recordDisclosure(
  disclosureId: Bytes<32>,
  auditorId: Bytes<32>,
  scopeCommitment: Bytes<32>,
  expires: Uint<64>
): [] {
  assertAdmin();
  const publicId = disclose(disclosureId);
  disclosures.insert(publicId, DisclosurePublic {
    auditorId: disclose(auditorId),
    scopeCommitment: disclose(scopeCommitment),
    expires: disclose(expires)
  });
}
